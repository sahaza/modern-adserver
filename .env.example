# Modern AdServer configuration — copy to .env and adjust.
# All variables are optional; defaults are shown below.

# Port the HTTP server listens on (default: 3000)
PORT=3000

# Bind address (default: 127.0.0.1 — loopback only).
# Set to 0.0.0.0 when running in a container or behind a reverse proxy.
HOST=127.0.0.1

# PostgreSQL connection string. When empty/unset, the server runs with
# in-memory storage (useful for development; data is lost on restart).
# The database schema is created automatically on startup.
# Example: postgres://adserver:adserver@localhost:5432/adserver
DATABASE_URL=
