{
  "name": "@revive/adserver-node",
  "version": "0.1.0",
  "private": true,
  "description": "Revive Adserver next-generation core — TypeScript/Node.js rewrite of the ad server",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "kysely": "^0.28.2",
    "pg": "^8.14.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
